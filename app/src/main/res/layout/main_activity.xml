<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/homeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMKitUI Demo"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:visibility="invisible"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Built-in assessment"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/builtInAssessmentTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/startAssessment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Built-In Assessment" />

            <Button
                android:id="@+id/startCustomWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Start Custom Workout" />

            <Button
                android:id="@+id/startCustomAssessment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Start Custom Assessment" />

            <EditText
                android:id="@+id/programIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Program ID supplied by Sency"
                android:importantForAutofill="no"
                android:inputType="text" />

            <Button
                android:id="@+id/startWorkoutProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Workout Program" />

            <Button
                android:id="@+id/sdkFeaturesDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SDK Features Demo" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/sdkFeaturesScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/sdkFeaturesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backToHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back" />

            <TextView
                android:id="@+id/sdkFeaturesTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:text="SDK Features Demo"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/sdkFeatureSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/sdkFeatureSettingsPanel"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configuration"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/showPhoneCalibrationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Show phone calibration" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pose model (reconfigure)" />

            <Spinner
                android:id="@+id/poseModelChoiceSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Color theme" />

            <Spinner
                android:id="@+id/colorThemeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Session language" />

            <Spinner
                android:id="@+id/sessionLanguageSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone calibration language" />

            <Spinner
                android:id="@+id/phoneCalibrationLanguageSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Session behavior"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/useDefaultGuidanceModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use default guidance mode" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/guidanceDebugLoggingSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guidance debug logging" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/guidanceModeSuggestionSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guidance suggestions" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/smallBodyPartFocusSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instruction-video body-part focus" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/variationMismatchFeedbackSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Variation mismatch feedback" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/phoneMovementPreventionSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone movement count prevention" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/startTimerOnFirstActivitySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Start timer on first activity" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/exerciseSummaryTimingMetricsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export exercise timing metrics (reconfigure)" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/includeAssessmentInsightsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download assessment insights (reconfigure)" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/exportAssessmentInsightsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export assessment insights" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/perfectOnlyCounterSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Count perfect reps only" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/targetBasedCompletionSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Target-based exercise completion" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/mediumCycleInstructionVideoSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medium-cycle instruction video" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medium-size video cycles (1–5)" />

            <EditText
                android:id="@+id/instructionVideoCyclesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:inputType="number"
                android:maxLines="1"
                android:text="3" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/playPhoneCalibrationAudioSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone calibration audio" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/playBodyCalibrationAudioSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Body calibration audio" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/allowAudioMixingSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow audio mixing" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/showExternalAudioControlSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show external audio control" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/enableButtonTutorialSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable button tutorial" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/intelligenceRestSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intelligence rest" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/excludePushupKneesFeedbackSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hide push-up knees feedback in UI" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Skeleton appearance"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/skeletonHiddenSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hide skeleton" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skeleton preset" />

            <Spinner
                android:id="@+id/skeletonPresetSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connection style" />

            <Spinner
                android:id="@+id/skeletonConnectionStyleSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Joint shape" />

            <Spinner
                android:id="@+id/skeletonJointShapeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dots inner color" />

            <Spinner
                android:id="@+id/skeletonDotsInnerColorSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dots outer color" />

            <Spinner
                android:id="@+id/skeletonDotsOuterColorSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connections inner color" />

            <Spinner
                android:id="@+id/skeletonConnectionsInnerColorSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connections outer color" />

            <Spinner
                android:id="@+id/skeletonConnectionsOuterColorSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dots opacity" />

            <SeekBar
                android:id="@+id/skeletonDotsOpacitySeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connections opacity" />

            <SeekBar
                android:id="@+id/skeletonConnectionsOpacitySeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dots glow" />

            <SeekBar
                android:id="@+id/skeletonDotsGlowSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connections glow" />

            <SeekBar
                android:id="@+id/skeletonConnectionsGlowSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Line width (0.5–2.0)" />

            <SeekBar
                android:id="@+id/skeletonLineWidthSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150"
                android:progress="50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Outline width (0.5–2.0)" />

            <SeekBar
                android:id="@+id/skeletonOutlineSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150"
                android:progress="50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Softness" />

            <SeekBar
                android:id="@+id/skeletonSoftnessSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Animation duration (0–50 ms)" />

            <SeekBar
                android:id="@+id/skeletonAnimationSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="50" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Pause buttons"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/pauseResumeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Resume" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/pauseSkipSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Skip" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/pauseStartOverSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Start over" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/pauseQuitSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Quit" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/pauseRestSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Rest" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/pauseSwitchSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Switch" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Per-exercise options"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/useWideAngleCameraSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wide-angle camera" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/shortIntroSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Short intro" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/preExerciseCountdownSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pre-exercise countdown" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/soundOnEachRepSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sound on each rep" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/repMilestoneVoiceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rep milestone voice" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/targetRepsCompletionVoiceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Target-reps completion voice" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/intentVoiceFeedbackSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exercise intent voice feedback" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/showTargetProgressSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show target-reps progress" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/adaptiveRomFeedbackSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adaptive ROM feedback" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/stretchSetConfigSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stretch set config" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/positionRepsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repeated position holds" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/exerciseProgressDisplaySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Section and circuit progress display" />

            <TextView
                android:id="@+id/workoutContinuationTimerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Workout continuation timer seconds"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/workoutContinuationTimerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:inputType="number"
                android:maxLines="1"
                android:text="10" />

            <EditText
                android:id="@+id/sdkConfigStringInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Optional flat native config string"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="3" />

            <Button
                android:id="@+id/applySdkConfiguration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reconfigure SDK" />

            <Button
                android:id="@+id/clearAdaptiveRomCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Clear Adaptive ROM Cache" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/sdkFeatureSelectedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Selected: 0"
            android:textSize="16sp" />

        <ScrollView
            android:id="@+id/sdkExerciseListScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/sdkExerciseListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/sdkFeatureActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/selectAllSdkExercises"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Select All" />

            <Button
                android:id="@+id/clearSdkExerciseSelection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="Clear" />

            <Button
                android:id="@+id/startSdkFeaturesWorkout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Start" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
